# ============================================================
# General.config —— 按方案精简版
# 原版(作者默认)含 samba4/frp/ddns/upnp/wol/diskman/hd-idle/3cat/
# watchcat/coremark/zram 等大量额外组件, 且 Passwall 默认带 Xray。
# 本版按方案要求: 只保留 Passwall + 单一 sing-box + rtp2httpd。
# 注意: 本文件在 .config 合并时排在设备配置之后(后行覆盖前行),
# 所以 Passwall 的 INCLUDE 开关必须在这里写全, 才能压掉包内默认值。
# ============================================================

# --- 构建环境 ---
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# --- 系统/LuCI 基础(中文) ---
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_LUCI_LANG_zh_Hans=y
# 方案: 不用传统/繁体界面
# CONFIG_LUCI_LANG_zh_Hant is not set

# --- 代理管理: Passwall(nftables 透明代理), 仅 sing-box 核心 ---
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
# Geoview 属于方案"分流辅助"行(Passwall 依赖的规则/geo 组件), 保留
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# SmartDNS 在 aarch64 上默认 y(passwall Makefile: default y if aarch64), 必须显式关闭
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# 只保留一个核心: Xray 及其余核心/插件全部关闭
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# 不使用 Passwall2 / OpenClash, 避免多个代理管理插件并存
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# --- sing-box 构建标签精简: 解决 stock 布局 35.75 MiB 分区放不下的问题 ---
# 实测 sing-box 二进制 55.6 MB(占 rootfs 未压缩体积 50%), GVisor + Tailscale 是最大来源,
# 对家用分流无实际用途, 故关闭; QUIC/UTLS/WireGuard/Clash API/ACME 全部保留。
# CONFIG_SING_BOX_BUILD_GVISOR is not set
# CONFIG_SING_BOX_BUILD_TAILSCALE is not set

# --- rtp2httpd: IPTV 组播转 HTTP 单播 ---
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y

# --- 明确不编译的大件(方案要求) ---
# CONFIG_PACKAGE_openssh-sftp-server is not set
# CONFIG_PACKAGE_nano-full is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_dmesg is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_luci-app-hd-idle is not set
# CONFIG_PACKAGE_luci-app-3cat is not set
# CONFIG_PACKAGE_luci-app-watchcat is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-acme is not set
# 注: autocore/luci-app-cpufreq/automount/e2fsprogs 等是 LibWrt qualcommax 目标的
# DEFAULT_PACKAGES(底座强制自带), .config 无法排除, 如需裁剪须改 target.mk(方案不建议首轮动底座)
# CONFIG_PACKAGE_luci-app-uhttpd is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_tmux is not set
# CONFIG_PACKAGE_btop is not set
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_cfdisk is not set
# CONFIG_PACKAGE_sgdisk is not set
# CONFIG_PACKAGE_tune2fs is not set
# CONFIG_PACKAGE_fstrim is not set
# CONFIG_PACKAGE_hdparm is not set
# CONFIG_PACKAGE_smartmontools-drivedb is not set
# CONFIG_PACKAGE_ddns-scripts-cloudflare is not set
# CONFIG_PACKAGE_acme-acmesh-dnsapi is not set
# CONFIG_PACKAGE_sqm-scripts-nss is not set

# --- 方案要求: 不走 OpenWrt 软件/硬件 Flow Offloading 与 Packet Steering ---
# (不选 kmod-nft-flow-offload / kmod-ipt-flowoffload / packet-steering,
#  卸载统一交给 NSS ECM, 避免两套路径冲突)
# CONFIG_PACKAGE_kmod-nft-flow-offload is not set
# CONFIG_PACKAGE_kmod-ipt-flowoffload is not set
# CONFIG_PACKAGE_packet-steering is not set
