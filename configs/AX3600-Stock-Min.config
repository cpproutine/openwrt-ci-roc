# ============================================================
# Xiaomi AX3600 (stock layout / 原厂分区) 专用设备配置
# 底座: LibWrt 25.12-nss (via openwrt-ci-roc 云编译)
# 对应方案: AX3600_LibWrt_NSS_完整方案.md
# ============================================================

# --- Target / 设备（只出 xiaomi_ax3600-stock 一个机型）---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax3600-stock=y
# 明确排除扩展分区布局的普通版，防止误刷
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax3600 is not set

# --- NSS 内存档: AX3600 是 512MB, 必须覆盖 ipq807x 默认的 1GB(HIGH) 档 ---
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
# CONFIG_NSS_MEM_PROFILE_HIGH is not set
# CONFIG_NSS_MEM_PROFILE_LOW is not set

# --- ath11k 内存档: 512MB ---
CONFIG_ATH11K_MEM_PROFILE_512M=y
# CONFIG_ATH11K_MEM_PROFILE_1G is not set

# --- NSS 固件: 11.4 (LibWrt 官方矩阵: WiFi WDS/MESH 及部分功能需 11.4) ---
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# --- Wi-Fi NSS 卸载开启 / Mesh 关闭(ath11k NSS mesh 存在故障) ---
# ATH11K_NSS_SUPPORT 默认 y (自动选中 NSS_DRV_WIFIOFFLOAD_ENABLE 与 ECM), 保持默认
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
